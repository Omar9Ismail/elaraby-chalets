{
  "rules": {
    ".read": false,
    ".write": false,
    "elaraby_auth_roles": {
      ".read": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'sales' || newData.val() === 'disabled')"
      },
      "oBEyeBieaPMuNCUadC95PqJrOCH2": {
        ".validate": "newData.val() === 'admin'"
      }
    },
    "elaraby_private_users": {
      ".read": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales') && auth.uid === $uid"
      }
    },
    "elaraby_directory": {
      ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'"
    },
    "elaraby_treasury": {
      ".read": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'"
    },
    "elaraby_system_v11_core": {
      ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      ".validate": "!newData.hasChild('users') && !newData.hasChild('expenses') && !newData.hasChild('auditLog') && !newData.hasChild('passwordAlerts') && !newData.hasChild('globalCommConfig') && !newData.hasChild('villageCommissions')"
    },
    "elaraby_maintenance": {
      ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')",
      ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'"
    },
    "elaraby_system_v11_bookings": {
      ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')",
      "$id": {
        ".write": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')"
      }
    },
    "elaraby_v8_photos": {
      ".read": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')",
      "chalets": {
        ".write": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'"
      },
      "bookings": {
        "$id": {
          ".write": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales')"
        }
      }
    },
    "online_presence": {
      ".read": "auth != null && root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin'",
      "$username": {
        ".write": "auth != null && (root.child('elaraby_auth_roles').child(auth.uid).val() === 'admin' || root.child('elaraby_auth_roles').child(auth.uid).val() === 'sales') && (auth.token.email === $username + '@elaraby.local')"
      }
    }
  }
}
